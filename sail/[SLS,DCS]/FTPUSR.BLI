00100	MODULE FTPUSR(STACK,MLIST)=
00200	BEGIN
00300	%    THIS IS A SIMPLE USER END OF THE FTP USER/SERVER METHOD
00400	FOR EFFECTING FILE TRANSFER. %
00500	OWN TELIBK[5],
00600	    TELOBK[5],
00700	    ICPBLK[5],
00800	    DATIBK[5],
00900	    DATOBK[5],
01000	    TTIBHD[3],
01100	    TTOBHD[3],
01200	    FILIBD[3],
01300	    FILOBD[3],
01400	    DATIBD[3],
01500	    DATOBD[3],
01600	    TELIBD[3],
01700	    TELOBD[3],
01800	    ICPBHD[3],
01900	    LCLSKT,
02000	    REMSKT,
02100	    SVJBFF,
02200	    TEMP,
02300	    FILE,
02400	    EXT;
02500	BIND
02600	    F=BREG,
02700	    IDBLST=#51,
02800	    JOBJDA=#75,
02900	    FILCHN=1,
03000	    TTYCHN=2,
03100	    DATCHN=3,
03200	    TELCHN=4,
03300	    ICPCHN=5,
03400
03500	    IMPIMP=0,
03600	    IMPLOG=1,
03700	    IMPERR=1,
03800	    IMPLCL=2,
03900	    IMPHST=3,
04000	    IMPRMT=4,
04100
04200	    TELSKT=1,
04300	    FTPSKT=3,
04400
04500	    BHDBUF=0,
04600	    BHDPNT=1,
04700	    BHDCNT=2,
04800
04900	    AL=1,
05000	    IMG=#10,
05100	    BIN=#14;
05200
05300	MACRO
05400	    VEND=RETURN .VREG END$,
05500	    NEWLIN=TTIBHD[BHDCNT]_0$,
05600	    IMPUUO(R)=CALLI(R,-#17)$,
05700	    TELOPN=26,1$,
05800	    PEEK(R)=CALLI(R,#33)$,
05900	    FILEOF=25,1$,
06000	    DATEOF=24,1$,
06100	    TTYORD=23,1$;	!FLAG WHICH SAYS TTY OUPUT PENDING
06200
06300	EXTERNAL
06400	     JOBFF;
     00100	%THIS FILE CONTAINS SOME SIMPLE IO ROUTINES THAT OFTEN MAKE
00200	LIFE EASIER.	%
00300
00400	MACRO
00500	    ADDR=0,0$,
00600	    AC=23,4$,
00700	    INST=27,9$,
00800	    FADDR=0,23$,
00900	    RH=0,18$,
01000	    LH=18,18$,
01100	    ASC=36,7$,
01200	    ASZ=PLIT ASCIZ$,
01300	    SKIP(INSTT)=(SETO(VREG);INSTT;SETZ(VREG))$,
01400	    DEC(ADR)=(ADR_.ADR-1)$,
01500	    INC(ADR)=(ADR_.ADR+1)$,
01600	    IFF=IF 0 EQL$,
01700	    IFT=IF 0 NEQ$;
01800	BIND
01900	    TRUE=-1,
02000	    FALSE=0;
02100
02200	MACHOP
02300	    TTCALL=#051,
02400	    SETSTS=#060,
02500	    GETSTS=#062,
02600	    INBUF=#064,
02700	    INPUT=#066,
02800	    OUTPUT=#067,
02900	    CLOSE=#070,
03000	    RELEASE=#071,
03100	    CALLI=#047,
03200
03300	!USEFUL OTHER INSTS:
03400	    JFCL=#255,
03500	    SETZ=#400,
03600	    SETO=#474,
03700	    XCT=#256;
03800	BIND
03900	    INIT=#050,!	ACTUALLY A OPEN!
04000	    IN=#056,
04100	    OUT=#057,
04200	    USETI=#074,
04300	    USETO=#075,
04400	    LOOKUP=#076,
04500	    ENTER=#077;
     00100	FORWARD TTICHR,TTOCHR;
00200	ROUTINE OPEN(CHN,MODE,DEV,BUFS)=
00300	    BEGIN
00400	    REGISTER R;
00500	    R_(INIT^4+.CHN)^23+MODE<ADDR>;
00600	    SETO(VREG);XCT(0,R);SETZ(VREG);
00700	    VEND;
00800
00900	ROUTINE TYPOCT(NUM)=
01000	    BEGIN
01100	    REGISTER R;
01200	    R_.NUM MOD 8+#60;
01300	    IF .NUM/8 NEQ 0 THEN TYPOCT(.NUM/8);
01400	    TTOCHR(.R);
01500	    END;
01600
01700	ROUTINE TYPDEC(NUM)=
01800	    BEGIN
01900	    REGISTER R;
02000	    R_.NUM MOD 10+#60;
02100	    IF .NUM/10 GTR 0 THEN TYPDEC(.NUM/10);
02200	    TTOCHR(.R);
02300	    END;
02400
02500	ROUTINE INSIX=
02600	    BEGIN
02700	% THIS ROUTINE INPUTS AND RETURNS A SIXBIT NAME. IT IGNORES
02800	SPACES, CTRL CHARS, LOWER CASE, CHARS AFTER THE SIXTH,
02900	AND NEEDS A LF FOR A BREAK CHAR. %
03000	    REGISTER PNT,VAL,R;
03100	    VAL_0;
03200	    PNT_VAL<36,6>;
03300	    WHILE (R_TTICHR()) NEQ #12
03400		DO IF (R_.R-#40) GTR 0 THEN IF .PNT<30,6> NEQ 0
03500		    THEN REPLACEI(PNT,.R);
03600	    RETURN .VAL;
03700	    END;
03800
03900	ROUTINE TYPSIX(WRD)=
04000	    BEGIN
04100	    REGISTER PNT;
04200	    PNT_WRD<36,6>;
04300	    DO (F<RH>_SCANI(PNT)+#40;IF .F<RH> NEQ #40 THEN TTOCHR(.F)) UNTIL .PNT<30,6> EQL 0;
04400	    END;
04500
04600		FORWARD TELICH;		!***********
04700	ROUTINE TELCOM=
04800	    BEGIN
04900	    REGISTER R,CH;
05000	    DECR I FROM 2 TO 0 DO
05100		(TTOCHR(CH_TELICH());R_.R*10+.CH-"0");
05200	    DO TTOCHR(CH_TELICH()) UNTIL .CH EQL "?J";
05300	    RETURN .R
05400	    END;
05500
05600	ROUTINE TELIRD=
05700	    BEGIN
05800	    REGISTER R;
05900	    R_.(JOBJDA+TELCHN)<RH>+IDBLST;
06000	    RETURN PEEK(R);
06100	    END;
06200
06300	ROUTINE CHKTEL=
06400	    BEGIN
06500	    REGISTER R;
06600	    WHILE TELIRD() NEQ 0 OR .TELIBD[BHDCNT] GTR 1
06700		DO IF .R LSS TELCOM() THEN R_.VREG;
06800	    RETURN .R;
06900	    END;
     00100	ROUTINE DATIN=
00200	    BEGIN
00300	    IF DEC(DATIBD[BHDCNT]) LEQ 0
00400		THEN BEGIN
00500		INPUT(DATCHN);
00600		GETSTS(DATCHN,TEMP);
00700		F<DATEOF>_.TEMP^(-13) NEQ 0;
00800		END;
00900	    RETURN SCANI(DATIBD[BHDPNT]);
01000	    END;
01100
01200	ROUTINE DATOUT(WRD)=
01300	    BEGIN
01400	    IF DEC(DATOBD[BHDCNT]) LEQ 0 THEN OUTPUT(DATCHN);
01500	    REPLACEI(DATOBD[BHDPNT],.WRD);
01600	    END;
01700
01800	ROUTINE FILIN=
01900	    BEGIN
02000	    IF DEC(FILIBD[BHDCNT]) LEQ 0
02100		THEN BEGIN
02200		INPUT(FILCHN);
02300		GETSTS(FILCHN,TEMP);
02400		F<FILEOF>_.TEMP^(-13) NEQ 0;
02500		END;
02600	    RETURN SCANI(FILIBD[BHDPNT]);
02700	    END;
02800
02900	ROUTINE FILOUT(WRD)=
03000	    BEGIN
03100	    IF DEC(FILOBD[BHDCNT]) LEQ 0 THEN OUTPUT(FILCHN);
03200	    REPLACEI(FILOBD[BHDPNT],.WRD);
03300	    END;
     00100	ROUTINE TTICHR=
00200	    BEGIN
00300	    REGISTER CH;
00400	    IF .F<TTYORD> THEN (OUTPUT(TTYCHN);F<TTYORD>_0);
00500	    DO (IF DEC(TTIBHD[BHDCNT]) LEQ 0 THEN INPUT(TTYCHN);
00600		CH_SCANI(TTIBHD[BHDPNT])) UNTIL .CH NEQ 0;
00700	    IF .CH EQL "Z"-#100 THEN CLOSE(TTYCHN);
00800	    RETURN .CH;
00900	    END;
01000
01100	ROUTINE TTOCHR(CH)=
01200	    BEGIN
01300	    IF DEC(TTOBHD[BHDCNT]) LEQ 0 THEN OUTPUT(TTYCHN);
01400	    REPLACEI(TTOBHD[BHDPNT],.CH);
01500	    F<TTYORD>_TRUE;
01600	    END;
01700
01800	MACRO TTOSTR(STNG)=
01900	    TTOSTX((PLIT ASCIZ STNG)<36,7>)$;
02000
02100	ROUTINE TTOSTX(STNG)=
02200	    BEGIN
02300	    REGISTER CH;
02400	    UNTIL (CH_SCANI(STNG)) EQL 0 DO TTOCHR(.CH);
02500	    END;
02600
02700	ROUTINE ICPINP=
02800	    BEGIN
02900	    MACRO XXX=SCANI(ICPBHD[BHDPNT])$;
03000	    INPUT(ICPCHN);
03100	    RETURN ((XXX^8+XXX)^8+XXX)^8+XXX;
03200	    END;
03300
03400	ROUTINE TELICH=
03500	    BEGIN
03600	    IF DEC(TELIBD[BHDCNT]) LEQ 0 THEN IFT TELIRD() THEN INPUT(TELCHN) ELSE RETURN "?J";
03700	    RETURN SCANI(TELIBD[BHDPNT]);
03800	    END;
03900
04000	ROUTINE TELOCH(CH)=
04100	    BEGIN
04200	    IF DEC(TELOBD[BHDCNT]) LEQ 0 THEN OUTPUT(TELCHN);
04300	    REPLACEI(TELOBD[BHDPNT],.CH);
04350	    IF .CH EQL "?J" THEN OUTPUT(TELCHN);
04400	    END;
04500
04600	MACRO TELSTR(STNG)=
04700	    TELSTX((PLIT ASCIZ STNG)<36,7>)$;
04800
04900	ROUTINE TELSTX(STNG)=
05000	    BEGIN
05100	    REGISTER CH;
05200	    UNTIL (CH_SCANI(STNG)) EQL 0 DO TELOCH(.CH);
05300	    END;
05400
05500	ROUTINE TELLF=
05600	    BEGIN
05700	    REGISTER CH;
05800	    DO TELOCH(CH_TTICHR()) UNTIL .CH EQL "?J";
05900	    END;
06000
06100	ROUTINE INDEC=
06200	    BEGIN
06300	    REGISTER CUM,CH;
06400	    CUM_0;
06500	    UNTIL (CH_TTICHR();.CH LSS "0" OR .CH GTR "9")
06600		DO CUM_.CUM*10+.CH-"0";
06700	    RETURN .CUM;
06800	    END;
06900
07000	ROUTINE LOOK(CHN,FIL,EX,PROT,OWNER)=
07100	    BEGIN
07200	    REGISTER R;
07300	    R_(LOOKUP^4+.CHN)^23+FIL<ADDR>;
07400	    SETO(VREG);XCT(0,R);SETZ(VREG);
07500	    VEND;
07600
07700	ROUTINE ENT(CHN,FIL,EX,PROT,OWNER)=
07800	    BEGIN
07900	    REGISTER R;
08000	    R_(ENTER^4+.CHN)^23+FIL<ADDR>;
08100	    SETO(VREG);XCT(0,R);SETZ(VREG);
08200	    VEND;
     00100	OWN RX;
00200	!BEGIN
00300	!    REGISTER R;
00400	    BIND
00500		STATCD=0,
00600		CONNCD=3,
00700		CLOSCD=4,
00800		LISTCD=5,
00900
01000		DEASCD=12;
01100	    ROUTINE IMPCLL=
01200		BEGIN
01300		REGISTER R; R_.RX;
01400		IFF SKIP(IMPUUO(R))
01500		    THEN BEGIN
01600		    R_.IMPERR[.R];
01700		    TTOSTX(CASE .R OF SET
01800			(ASZ 'ILU - ILLEGAL FNC')<ASC>;
01900			(ASZ 'NSD - NOSUCH DEVICE')<ASC>;
02000			(ASZ 'DNA - DEVICE NOT AVAILABLE')<ASC>;
02100			(ASZ 'DNI - DEVICE NOT AN IMP')<ASC>;
02200			(ASZ 'STT - WRONG STATE FOR OPERATION')<ASC>;
02300			(ASZ 'SOF - SOCKET OPEN FAILURE')<ASC>;
02400			(ASZ 'SYS - SYSTEM FAILURE')<ASC>;
02500			(ASZ 'ABT - RFC ABORTED BY SENDER')<ASC>;
02600			(ASZ 'REQ - NON-MATCHING RFC PARAMETERS')<ASC>;
02700			(ASZ 'SKT - ILLEGAL SOCKET #')<ASC>;
02800			(ASZ 'HST - HOST # OUT OF RANGE')<ASC>;
02900			(ASZ 'DWN - REMOTE SITE DOWN')<ASC>;
03000			(ASZ 'ADR - ADDRESS CHECK (SHOULDNT BE)')<ASC>;
03100			(ASZ 'TIM - TIMEOUT ERROR')<ASC>;
03200			(ASZ 'PAR - PARAMETER SPECIFICATION ERROR')<ASC>;
03300			(ASZ 'PRV - PRIVILEDGED COMMAND')<ASC>
03400		    TES);
03500		    TTOSTR('?M?J');
03600		    RETURN .R; END
03700		    ELSE RETURN -1;
03800		END;
03900
04000	    ROUTINE LISTEN(IMPBLK)=
04100		(RX_LISTCD^18+(.IMPBLK)<ADDR>;IMPCLL());
04200
04300	    ROUTINE CONNECT(IMPBLK)=
04400		(RX_CONNCD^18+(.IMPBLK)<ADDR>;IMPCLL());
04500
04600	    ROUTINE CLOS(IMPBLK)=
04700		(RX_CLOSCD^18+(.IMPBLK)<ADDR>;IMPCLL());
04800
04900	    ROUTINE DEAS(IMPBLK)=
05000		(RX_DEASCD^18+(.IMPBLK)<ADDR>;IMPCLL());
05100
05200	    ROUTINE STATUS(IMPBLK)=
05300		(RX_STATCD^18+(.IMPBLK)<ADDR>;IMPCLL());
05400	!    END;
     00100	ROUTINE ICP(HOSTN,LCLSKT,ICPSKT)=
00200	    BEGIN
00300	    TELIBK[IMPIMP]_0;
00400	    TELIBK[IMPLCL]_.LCLSKT+3;
00500	    TELIBK[IMPRMT]_0;
00600	    TELIBK[IMPHST]_#10^18+.HOSTN;
00700	    LISTEN(TELIBK);
00800
00900	    TELOBK[IMPIMP]_.TELIBK[IMPIMP];
01000	    TELOBK[IMPLCL]_.LCLSKT+2;
01100	    TELOBK[IMPHST]_.TELIBK[IMPHST];
01200	    TELOBK[IMPRMT]_0;
01300	    LISTEN(TELOBK);
01400
01500	    ICPBLK[IMPIMP]_0;
01600	    ICPBLK[IMPLCL]_.LCLSKT;
01700	    ICPBLK[IMPRMT]_.ICPSKT;
01800	    ICPBLK[IMPHST]_32^18+.HOSTN;
01900	    CONNECT(ICPBLK);
02000
02100	    OPEN(ICPCHN,3,.ICPBLK[IMPIMP],ICPBHD<ADDR>);
02200	    REMSKT_ICPINP();
02300	    TELIBK[IMPRMT]_.REMSKT;
02400	    TELOBK[IMPRMT]_.REMSKT+1;
02500	    CONNECT(TELIBK);
02600	    CONNECT(TELOBK);
02700	    CLOS(ICPBLK);
02800	    DEAS(ICPBLK);
02900	    RELEASE(ICPCHN);
03000	    END;
     00100	ROUTINE USER=
00200	    (TELSTR('USER');TELLF());
00300
00400	ROUTINE PASS=
00500	    (TELSTR('PASS');TELLF());
00600
00700	ROUTINE HOST=
00800	    BEGIN
00900	    TTICHR();	!READ A SPACE FOR PRETTY FORMATTING
01000	    ICP(INDEC(),.LCLSKT,FTPSKT);
01100	    OPEN(TELCHN,AL,.TELIBK[IMPIMP],TELOBD<ADDR>^18+TELIBD<ADDR>);
01200	    INBUF(TELCHN,2);
01300	    F<TELOPN>_TRUE;
01400	    CHKTEL();
01500	    END;
01600
01700	ROUTINE SEND=
01800	    BEGIN
01900	    REGISTER WRD;
02000	    SVJBFF_.JOBFF;
02100	    TTOSTR('THIS FILE: ');
02200	    NEWLIN;
02300	    FILE_INSIX();
02400	    TTOSTR('EXT: ');
02500	    EXT_INSIX();
02600	    OPEN(FILCHN,BIN,SIXBIT 'DSK',FILIBD<ADDR>);
02700	    IFF LOOK(FILCHN,.FILE,.EXT,0,0)
02800		THEN (TYPOCT(.EXT<RH>);TTOSTR(' ERROR FROM LOOKUP?M?J');RETURN);
02900	    TTOSTR('THAT PATH: ');
03000	    TELSTR('STOR ');
03100	    TELLF();
03200	    DATOBK[IMPIMP]_0;
03300	    DATOBK[IMPLCL]_.LCLSKT+5;
03400	    DATOBK[IMPHST]_36^18+.TELOBK[IMPHST]<RH>;
03500	    DATOBK[IMPRMT]_.REMSKT+4;
03600	    LISTEN(DATOBK);
03700	    CONNECT(DATOBK);
03800	    OPEN(DATCHN,IMG,.DATOBK[IMPIMP],DATOBD<ADDR>^18);
03900	    UNTIL (WRD_FILIN();.F<FILEOF>) DO DATOUT(.WRD);
04000	    CLOSE(FILCHN);
04100	    RELEASE(FILCHN);
04200	    CLOSE(DATCHN);
04300	    RELEASE(DATCHN);
04400	    JOBFF_.SVJBFF;
04500	    CLOS(DATOBK<ADDR>);
04600	    DEAS(DATOBK<ADDR>);
04700	    END;
     00100	ROUTINE RETR=
00200	    BEGIN
00300	    REGISTER WRD;
00400	    SVJBFF_.JOBFF;
00500	    TTOSTR('THIS FILE: ');
00600	    NEWLIN;
00700	    FILE_INSIX();
00800	    TTOSTR('EXT: ');
00900	    EXT_INSIX();
01000	    OPEN(FILCHN,BIN,SIXBIT'DSK',FILOBD<ADDR>^18);
01100	    IFF ENT(FILCHN,.FILE,.EXT,0,0)
01200		THEN (TYPOCT(.EXT<RH>);TTOSTR(' ERROR FROM ENTER?M?J');RETURN);
01300	    TTOSTR('THAT PATH: ');
01400	    TELSTR('RETR ');
01500	    TELLF();
01600	    DATIBK[IMPIMP]_0;
01700	    DATIBK[IMPLCL]_.LCLSKT+4;
01800	    DATIBK[IMPHST]_36^18+.TELIBK[IMPHST]<RH>;
01900	    LISTEN(DATIBK<ADDR>);
02000	    DATIBK[IMPRMT]_.REMSKT+5;
02100	    CONNECT(DATIBK<ADDR>);
02200	    OPEN(DATCHN,IMG,.DATIBK[IMPIMP],DATIBD<ADDR>);
02300	    UNTIL (WRD_DATIN();.F<DATEOF>) DO FILOUT(.WRD);
02400	    CLOSE(DATCHN);
02500	    RELEASE(DATCHN);
02600	    CLOS(DATIBK<ADDR>);
02650	    DEAS(DATIBK<ADDR>);
02700	    CLOSE(FILCHN);
02800	    RELEASE(FILCHN);
02900	    JOBFF_.SVJBFF;
03000	    END;
03100
03200	ROUTINE QUIT=
03300	    BEGIN
03400	    CLOS(TELIBK<ADDR>);
03500	    CLOSE(TELCHN);
03600	    RELEASE(TELCHN);
03700	    F<TELOPN>_FALSE;
03800	    CLOS(TELOBK<ADDR>);
03900	    DEAS(TELOBK<ADDR>);
04000	    END;
     00100	%ROUTINE HELP=
00200	    TTOSTR('FTP COMMANDS ARE 1 LETTER LONG AND INCLUDE:
00300	H <DEC #>	CONNECTS TO THAT HOST # (STANFORD IS 11)
00400	U <STR>		TELL THE FOREIGN HOST
00500			YOU ARE USER STR.
00600	P <STR>		TELLS SERVER THE USER'S PSW IS STR.
00700	S		PROMPTS FOR FILE, EXT TO SEND TO SERVER.
00800			SERVER FILENAME IS PROMPTED BY THAT PATH:.
00900	R		SEND, BACKWARD.
01000	Q		QUIT, BREAK CONNECTION. USE BEFORE YOU ^C.
01100	?		TYPE THIS BLURB.
01300	');%
01400
01500	ROUTINE PRCCMD=
01600	    BEGIN
01700	    SELECT (NEWLIN;TTOCHR("*");TTICHR()) OF NSET
01800		"U":USER();
01900		"P":PASS();
02000		"H":HOST();
02100		"S":SEND();
02200		"R":RETR();
02300		"Q":QUIT();
02400		"C":TELLF();
02500		"?M":;
02600	!	"?":HELP();
02700		OTHERWISE:TTOSTR('ILLEGAL COMMAND?M?J')
02800		TESN;
02900	    IF .F<TELOPN> THEN (OUTPUT(TELCHN);CHKTEL());
03000	    END;
03100
03200	!MAIN PROGRAM
03300	RESET;
03400	F_0;
03500	OPEN(TTYCHN,AL,SIXBIT 'TTY',TTOBHD<ADDR>^18+TTIBHD<ADDR>);
03600	TTOSTR('WELCOME TO FTP. PRAY YOUR STAY IS BEARABLE?M?J');
03700	LCLSKT_20;
03800	WHILE TRUE DO PRCCMD();
03900	END;

