	>			;[344] END IFN SETTTY

	WCHLSH==:^D17-WTCHDA	;AMOUNT TO SHIFT BITS RETURNED BY
				; SCAN FOR SETUUO

;LOWSEG STORAGE FOR LGNSCN
	RELOC
MSKMEM:	BLOCK	1	;MEMORY FOR MASK PRINTER
