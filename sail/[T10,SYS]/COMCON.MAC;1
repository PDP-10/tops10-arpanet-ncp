	PUSHJ	P,CHKMAX	;YES. CHECK JOB SIZES
	MOVEM	T2,CORMAX##	;SAVE NEW VALUE
	LSH	T2,W2PLSH##	;REDUCE TO N
	HRRM	T2,CORLIM##	;SAVE IN RH(CORLIM)
	JRST	CPOPJ1##	;AND SKIP RETURN
