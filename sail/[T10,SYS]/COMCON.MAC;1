	PUSHJ	P,PUTWDU##	;STORE ERROR NUMBER IN USER AC
	PUSH	P,.JDAT+JOBPD1## ;PUT RETURN ON END OF PDLIST
	JRST	USRXIT##	;AND RETURN TO USER TO HANDLE ERROR

SGRLE1:	POP	P,T1		;REMOVE ERROR CODE FROM LIST
