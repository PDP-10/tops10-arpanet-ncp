IFN FTCIMP,<

;HERE TO PROCESS SPECIAL IMP CHARACTER SETTINGS

;COMMANDS ARE:

;SET TTY (NO) QUOTE	;INITIAL SETTING: CTRL-Q
;SET TTY (NO) SHIFT	;NO INITIAL SETTING
;SET TTY (NO) LOCAL	;(LOCAL ESCAPE) INITILAL SETTING: CTRL-BACKARROW
;SET TTY (NO) NETWORK	;(NETWORK ESCAPE) NO INITIAL SETTING

;  NULL ARGUMENT IS EQUIVALENT TO (NO). ARGUMENT IS A SINGLE CHARACTER,
;  WHICH MUST NOT BE ALPHABETIC, BLANK, ESCAPE OR RUBOUT (QUOCHK IN
;  SCNSER CHECKS THIS). ALSO, IT MUST NOT ALREADY BE IN USE AS A
;  SPECIAL CHARACTER . SEE IMP HELP ESCAPE/CONTROL FOR MORE INFORMATION.

TTCIMC:	PUSH	P,T1		;PRESERVE AGAINST THE MORROW
	SETZ	T3,		;ASSUME CLEARING
	JUMPL	P1,TTCIM1	;INSTRUCTION IS (NO)
	PUSHJ	P,SKIPS		;RETURNS NEXT NON-BLANK CHAR IN T3
	 JFCL			;IGNORE CRLF RETURN
TTCIM1:	HRRZ	U,P1		;GET LDB BEING AFFECTED
	MOVE	T1,(P)		;RECOVER T1 JUST TO BE SURE
	HLRZ	T4,TTCDAT(T1)	;GET CODE: 0=QUOTE, 1=SHIFT, 2=LOCAL, 3=NET
	PUSHJ	P,QUOCHK##	;CHECK IT OUT AND STORE IF OK
	 JRST	TTCIME		;BLEW IT
	POP	P,T1		;RETURN OF THE NATIVE SON
	MOVSI	T4,LQLDWN##	;IF TTY SHIFT, CLEAR DOWNSHIFT FLAG
	HLRZ	T2,TTCDAT(T1)	;CODE AGAIN, PLEASE
	CAIN	T2,1		;IS IT SHIFT?
	ANDCAM	T4,LQLDWN##	;CLEAR DOWNSHIFT
	JUMPE	T3,CPOPJ1##	;IF NO ARG, RETURN
	PUSHJ	P,COMTYS	;CLEAN UP ANY EXTRA
	PJRST	CPOPJ1##	;DEPART

TTCIME:	POP	P,T1		;BAD CHARACTER - ADJUST STACK AND PRINT MSG
	JSP	T1,ERRMES
	ASCIZ	/Illegal value or character in use
/
> ;END IFN FTCIMP
