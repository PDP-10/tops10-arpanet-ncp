SENDT:
IFN FTNET,<
	SKIPGE	LDBREM##(U)	;IF UTM+ HOSTED AWAY
	JRST	SENDE1		;DON'T SEND
	PUSHJ	P,SNDSRC	;(237) DON'T EVEN LET OPR SEND TO LQPS
	  JRST	SNDBS2		;(237) LQP OR SOMETHING, SAY BUSY
