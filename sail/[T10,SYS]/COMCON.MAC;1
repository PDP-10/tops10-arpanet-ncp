	SKIPA	T2,[IORM P2,(T1)]	;NO--GO SET
	MOVSI	T2,(ANDCAM P2,(T1))	;YES--CLEAR
	XCT	T2
	HRRZ	P1,P1		;CLEAR FLAG
	PJRST	CPOPJ1##	;SKIP RETURN

