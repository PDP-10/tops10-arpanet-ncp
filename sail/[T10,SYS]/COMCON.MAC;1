;FNDNAM--ROUTINE TO SEARCH FOR ABBREV. NAME IN TABLE
;CALL	MOVE	T1,AOBJN POINTER TO LIST OF NAMES
;	MOVE	T2,SIXBIT ABBREVIATION
;	PUSHJ	P,FNDNAM
;NON-SKIP IF UNKNOWN (T1=0) OR DUPLICATE (T1 .NE. 0)
;SKIP RETURN IF FOUND WITH T1=INDEX IN TABLE


FNDNAM::PUSHJ	P,SAVE3##	;SAVE P1,P2,P3
	MOVN	P1,T2		;FIND THE RIGHTMOST
	AND	P1,T2		;NON-ZERO BIT IN COMMAND
	JFFO	P1,.+1		;AND ITS CARDINALITY
	IDIVI	P2,6		;FIND W HERE IN SIXBIT BYTE THE BIT IS
	LSH	P1,-5(P3)	;RIGHT-JUSTIFY THE BIT WITHIN THE BYTE
	SOJ	P1,		;MAKE MASK OF TRAILING BLANKS
	SETZB	T4,P2		;INITIALIZE MATCH POINTER AND COUNT
	MOVE	P3,T1		;SAVE POINTER
FNDNM2:	MOVE	T3,(T1)		;GET NEXT CANDIDATE
	XOR	T3,T2		;COMPARE
	JUMPE	T3,FNDNMW	;WIN
	ANDCM	T3,P1		;MASK IT
	JUMPN	T3,FNDNM3	;LOOSE
	MOVE	T4,T1		;WIN--SAVE POINTER
	ADDI	P2,1		;COUNT SUCCESS
FNDNM3:	AOBJN	T1,FNDNM2	;LOOP FOR ALL ENTRIES
FNDNM4:	MOVE	T1,T4		;RESTORE POSSIBLE WINNER
	SOJN	P2,CPOPJ##	;JUMP IF UNSUCCESSFUL
FNDNMW:	SUB	T1,P3		;COMPUTE INDEX
	TLZ	T1,-1		;REMOVE JUNK
	JRST	CPOPJ1##	;SKIP RETURN
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀;FNDABV--ROUTINE TO SEARCH FOR ABBREV. NAME IN LIST
;CALL	MOVE	T1,AOBJN POINTER TO LIST OF NAMES
;	MOVE	T2,SIXBIT ABBREVIATION
;	PUSHJ	P,FNDABV
;NON-SKIP IF UNKNOWN (T1=0) OR DUPLICATE (T1.NE.0)
;SKIP RETURN IF FOUND WITH T1=INDEX IN TABLE
;DIFFERS FROM FNDNAM THAT IT EXPECTS UNIQUENESS
;INFO IN PARALLEL UNIQNESS TABLE

FNDABV:	PUSHJ	P,SAVE4##	;SAVE P1,-P4
	HLRZ	P4,P3		;GET ADDRESS OF UNIQUENESS TABLE
	HRLI	P4,(POINT 6,)	;FORM BYTE POINTER
	MOVN	P1,T2		;FIND THE RIGHT MOST
	AND	P1,T2		;NON-ZERO BIT IN COMMAND
	JFFO	P1,.+1		;AND ITS CARDINALITY
	IDIVI	P2,6		;FIND WHERE IN SIXBIT BYTE THE BIT IS.
	LSH	P1,-5(P3)	;RIGHT JUSTIFY THE BIT WITHIN THE BYTE
	SUBI	P1,1		;MAKE MASK OF TRAILING BITS
	SETZB	T4,P2		;INITIALISE MATCH POINTER AND COUNT
	MOVE	P3,T1		;SAVE POINTER
FNDAB2:	MOVE	T3,(T1) 	;GET NEXT CANDIDATE
	XOR	T3,T2		;COMPARE
	JUMPE	T3,FNDNMW	;WIN
	ANDCM	T3,P1		;MASK IT
	JUMPN	T3,FNDAB4	;LOSE
	ILDB	T3,P4		;GET UNIQUENESS INFO
	JUMPE	T3,FNDAB3	;NO UNIQUENESS INFO
	TRNE	T3,UNIQ.1##	;UNIQUE AT 1 CHAR?
	JRST	FNDNMW		;THEN WE HAVE IT
	TRNN	T3,UNIQ.2##	;UNIQUE AT 2 CHARS?
	JRST	.+3		;NO
	TLNN	P1,7700		;DID WE HAVE AT LEAST 2 CHARS
	JRST	FNDNMW		;YES, SO WE HAVE IT
	TRNN	T3,UNIQ.3##	;UNIQUE AT 3 CHARS
	JRST	.+3		;NO
	TLNN	P1,77		;YES
	JRST	FNDNMW		;YES
	TRNN	T3,UNIQ.4##	;UNIQUE AT 4 CHARS?
	JRST	.+3		;NO
	TRNN	P1,770000	;DID WE HAVE AT LEAST 4 CHARS?
	JRST	FNDNMW		;YES
FNDAB3:	MOVE	T4,T1		;POSSIBLE WIN--SAVE POINTER
	AOJA	P2,FNDAB5	;COUNT SUCCESS
FNDAB4:	IBP	P4		;ADVANCE
FNDAB5:	AOBJN	T1,FNDAB2	;LOOP FOR ALL ENTRIES
	JRST	FNDNM4		;CHECK RESULT
