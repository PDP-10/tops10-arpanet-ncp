MBTRLC==:<<ABSLOC+777>/1000>*1000
				;DEFINE THIS SYMBOL SO WE GET MULTIPLY
				; DEFINED GLOBALS FROM LINK IF MONBTS IS 
				; NOT LOADED AFTER COMMON
>
IFNDEF	FTCMBTH,<END	SYSTRT>	;END UNLESS ASSEMBLING COMMONS TOGETHER
