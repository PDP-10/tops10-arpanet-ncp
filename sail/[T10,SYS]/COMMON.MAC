;	TE (SYNONYM FOR TECO).

;(110)	08-APR-77, JIM MCCOOL
;	MODULES AFFECTED: CLOCK1,COMCON,COMDEV,COMMON,CORE1,
;			  F,S,SCHED1,SCNSER,SYSINI,UUOCON
;	EDIT TYPE: ENHANCEMENT
